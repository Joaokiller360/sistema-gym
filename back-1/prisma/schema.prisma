generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GYM_OWNER
  GYM_ADMIN
  TRAINER
  RECEPTIONIST
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  FROZEN
  CANCELLED
}

enum GymSubscriptionStatus {
  ACTIVE
  TRIAL
  GRACE
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum InventoryStatus {
  ACTIVE
  OUT_OF_SERVICE
  MAINTENANCE
  RETIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

enum TicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
  NOTIFICATION
}

enum TicketCategory {
  BUG
  BILLING
  ACCESS
  FEATURE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DemoRequestStatus {
  PENDING
  CONTACTED
  DISMISSED
}

enum AccessRequestStatus {
  PENDING
  CONTACTED
  DISMISSED
  CONVERTED
}

model Gym {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  isActive         Boolean  @default(true)
  address          String?
  country          String?
  timezone         String   @default("UTC")
  currency         String   @default("USD")
  schedule         Json?
  subscriptionPlan        String   @default("BASIC")
  subscriptionStatus      GymSubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt   DateTime?
  subscriptionGraceEndsAt DateTime?
  trialEndsAt             DateTime?
  advancedReportsEnabled  Boolean  @default(false)
  /// Owner's WhatsApp number (E.164, digits only) for plan-limit alerts
  whatsappPhone           String?
  /// Highest member-limit threshold (%) already alerted; reset when usage drops
  memberLimitAlertLevel   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerId String? @unique
  owner   User?   @relation("GymOwner", fields: [ownerId], references: [id])

  users               User[]              @relation("GymUsers")
  branches            Branch[]
  plans               Plan[]
  members             Member[]
  trainers            Trainer[]
  classes             Class[]
  inventoryItems      InventoryItem[]
  communications      Communication[]
  campaigns           EmailCampaign[]
  templates           EmailTemplate[]
  gymBillingPayments  GymBillingPayment[]
  planStore           PlanStore[]
  products            Product[]
  productCategories   ProductCategory[]
  productSales        ProductSale[]
  memberCredits       MemberProductCredit[]
  supportTickets      SupportTicket[]
  waConversations     WaConversation[]

  @@map("gyms")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  isActive  Boolean  @default(true)
  language  String   @default("es")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the user finished (or skipped) the guided tour of the gym panel
  tourCompletedAt DateTime?

  gymId String?
  gym   Gym?    @relation("GymUsers", fields: [gymId], references: [id], onDelete: SetNull)

  ownedGym              Gym?                 @relation("GymOwner")
  adminCommunications   AdminCommunication[]

  @@index([gymId])
  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  members        Member[]
  trainers       Trainer[]
  classes        Class[]
  inventoryItems InventoryItem[]
  memberships    Membership[]
  payments       Payment[]
  attendances    Attendance[]

  @@index([gymId])
  @@map("branches")
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  price       Int
  currency    String   @default("USD")
  durationDays Int
  daysPerWeek Int?
  // Visit-limited plan: number of gym days included (null = unlimited within durationDays)
  visitLimit  Int?
  // People covered by one purchase (1 = individual, 2+ = shared "entre amigos" plan)
  maxMembers  Int      @default(1)
  benefits       Json     @default("[]")
  accessSchedule Json?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  storeEnabled  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  memberships Membership[]
  storeItem   PlanStore?

  @@index([gymId])
  @@map("plans")
}

model Member {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  birthDate DateTime?
  photoUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Wallet pass (WalletWallet). walletToken is the secret encoded in the pass QR.
  walletToken     String?   @unique
  walletSerial    String?
  walletShareUrl  String?
  walletGoogleUrl String?
  walletIssuedAt  DateTime?

  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  memberships      Membership[]
  payments         Payment[]
  attendances      Attendance[]
  classEnrollments ClassEnrollment[]
  productCredits   MemberProductCredit[]
  productSales     ProductSale[]

  @@index([gymId])
  @@index([branchId])
  @@unique([gymId, firstName, lastName])
  @@map("members")
}

model Membership {
  id        String           @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  frozenAt  DateTime?
  frozenDays Int             @default(0)
  // Snapshot of plan.visitLimit at creation; one visit is consumed per gym day attended
  visitsTotal Int?
  visitsUsed  Int            @default(0)
  // Memberships bought together under a shared plan share this id (one row per person)
  groupId   String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  payments    Payment[]
  attendances Attendance[]

  @@index([gymId])
  @@index([memberId])
  @@index([planId])
  @@index([status])
  @@index([groupId])
  @@map("memberships")
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  currency  String        @default("USD")
  method    PaymentMethod @default(CASH)
  notes     String?
  receiptUrl String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gymId        String
  memberId     String
  member       Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([branchId])
  @@map("payments")
}

model Attendance {
  id        String    @id @default(uuid())
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  createdAt DateTime  @default(now())

  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  groupId  String?
  group    AttendanceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Set when this check-in consumed a visit from a visit-limited membership
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([memberId])
  @@index([branchId])
  @@index([checkIn])
  @@index([groupId])
  @@index([membershipId])
  @@map("attendances")
}

model AttendanceGroup {
  id          String       @id @default(uuid())
  name        String
  gymId       String
  createdAt   DateTime     @default(now())
  attendances Attendance[]

  @@index([gymId])
  @@map("attendance_groups")
}

model Trainer {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  specialty    String?
  isActive     Boolean  @default(true)
  availability Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  classes Class[]

  @@index([gymId])
  @@index([branchId])
  @@map("trainers")
}

model Class {
  id          String   @id @default(uuid())
  name        String
  description String?
  maxCapacity Int
  schedule    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymId     String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  enrollments ClassEnrollment[]

  @@index([gymId])
  @@index([branchId])
  @@index([trainerId])
  @@map("classes")
}

model ClassEnrollment {
  id        String    @id @default(uuid())
  enrolledAt DateTime @default(now())
  attended  Boolean   @default(false)
  attendedAt DateTime?

  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([memberId, classId])
  @@index([gymId])
  @@index([memberId])
  @@index([classId])
  @@map("class_enrollments")
}

model InventoryItem {
  id           String          @id @default(uuid())
  name         String
  description  String?
  quantity     Int             @default(1)
  status       InventoryStatus @default(ACTIVE)
  serialNumber String?
  purchaseDate DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  maintenances Maintenance[]

  @@index([gymId])
  @@index([branchId])
  @@map("inventory_items")
}

model Maintenance {
  id              String          @id @default(uuid())
  type            MaintenanceType
  description     String
  responsibleName String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())

  gymId           String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([inventoryItemId])
  @@map("maintenances")
}

model Communication {
  id          String   @id @default(uuid())
  subject     String
  body        String
  recipientIds String[]
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("communications")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gymId     String
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]

  @@index([gymId])
  @@map("email_templates")
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  key          String   @unique
  label        String
  price        Int
  currency     String   @default("USD")
  durationDays Int      @default(30)
  graceDays    Int      @default(5)
  maxMembers      Int?
  storeEnabled    Boolean  @default(false)
  features        Json     @default("[]")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  discountPercent Int?
  discountActive  Boolean  @default(false)
  yearlyPrice     Int?
  demoEnabled             Boolean  @default(false)
  trialEnabled            Boolean  @default(false)
  visibleOnLanding        Boolean  @default(true)
  advancedReportsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscription_plans")
}

model GymBillingPayment {
  id          String        @id @default(uuid())
  amount      Int
  currency    String        @default("USD")
  method      PaymentMethod @default(CASH)
  notes       String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("gym_billing_payments")
}

model EmailCampaign {
  id          String         @id @default(uuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  segment     Json           @default("{}")
  scheduledAt DateTime?
  sentAt      DateTime?
  metrics     Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  gymId      String
  gym        Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@map("email_campaigns")
}

// ── Store / Mini-tienda ─────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([gymId])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  price       Int
  cost        Int?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymId      String
  gym        Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  saleItems ProductSaleItem[]
  credits   MemberProductCredit[]

  @@index([gymId])
  @@index([categoryId])
  @@map("products")
}

model ProductSale {
  id        String        @id @default(uuid())
  total     Int
  method    PaymentMethod @default(CASH)
  notes     String?
  createdAt DateTime      @default(now())

  gymId    String
  gym      Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  items   ProductSaleItem[]
  credits MemberProductCredit[]

  @@index([gymId])
  @@index([memberId])
  @@map("product_sales")
}

model ProductSaleItem {
  id        String @id @default(uuid())
  quantity  Int
  unitPrice Int

  saleId    String
  sale      ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("product_sale_items")
}

model MemberProductCredit {
  id        String    @id @default(uuid())
  quantity  Int
  unitPrice Int
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  gymId      String
  gym        Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  paidSaleId String?
  paidSale   ProductSale? @relation(fields: [paidSaleId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([memberId])
  @@index([productId])
  @@map("member_product_credits")
}

// ── Tienda de Planes ────────────────────────────────────────

model PlanStore {
  id           String   @id @default(uuid())
  displayOrder Int      @default(0)
  promoText    String?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planId String @unique
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("plan_store")
}

// ── Support Tickets ─────────────────────────────────────────

model SupportTicket {
  id             String         @id @default(uuid())
  title          String
  description    String
  priority       TicketPriority @default(NORMAL)
  category       TicketCategory @default(OTHER)
  status         TicketStatus   @default(OPEN)
  adminNotes     String?
  createdByEmail String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([status])
  @@map("support_tickets")
}

// ── Platform Settings (singleton) ───────────────────────────

model PlatformSettings {
  id                  String   @id @default("1")
  saasName            String   @default("GymSystem")
  logoUrl             String?
  creatorName         String?
  creatorUrl          String?
  footerText          String?
  footerLinks         Json     @default("[]")
  footerShowPoweredBy Boolean  @default(true)
  heroTitle           String?
  heroSubtitle        String?
  heroCtaText         String?
  heroCtaUrl          String?
  primaryColor        String?
  landingFeatures     Json     @default("[]")
  landingShowPlans    Boolean  @default(true)
  availableSlots      Json     @default("[]")
  termsContent        String?
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model NewsPost {
  id          String   @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news_posts")
}

model Tutorial {
  id          String   @id @default(uuid())
  title       String
  description String?
  videoUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutorials")
}

model DemoRequest {
  id        String            @id @default(uuid())
  name      String
  email     String
  phone     String?
  gymName   String
  planId    String
  planLabel String
  status    DemoRequestStatus @default(PENDING)
  ip        String?
  statusChangedById String?
  statusChangedAt   DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@map("demo_requests")
}

model AccessRequest {
  id              String              @id @default(uuid())
  name            String
  email           String
  phone           String?
  country         String?             @db.VarChar(10)
  callingCode     String?             @db.VarChar(8)
  postalCode      String?             @db.VarChar(20)
  preferredDate   DateTime
  status          AccessRequestStatus @default(PENDING)
  convertedAt     DateTime?
  convertedById   String?
  convertedGymId  String?
  createdAt       DateTime            @default(now())

  @@index([status])
  @@map("access_requests")
}

model AdminCommunication {
  id           String   @id @default(uuid())
  subject      String   @db.VarChar(150)
  body         String
  filter       String   @db.VarChar(10)
  recipientIds String[]
  senderName   String?  @db.VarChar(60)
  sentById     String?
  sentBy       User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sent         Int      @default(0)
  failed       Int      @default(0)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([sentAt(sort: Desc)])
  @@map("admin_communications")
}

// ── CRM: WhatsApp conversations with gym owners ─────────────

enum WaDirection {
  IN
  OUT
}

enum CrmStatus {
  OPEN
  PENDING
  CLOSED
}

model WaConversation {
  id            String    @id @default(uuid())
  /// E.164 digits only, as Meta sends it
  phone         String    @unique
  /// WhatsApp profile name of the contact
  contactName   String?
  /// Zernio inbox conversation id (needed to reply through Zernio)
  externalId    String?   @unique
  status        CrmStatus @default(OPEN)
  notes         String?
  unreadCount   Int       @default(0)
  lastMessageAt DateTime  @default(now())
  /// Free-form replies are only allowed within 24 h of this (Meta customer service window)
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gymId    String?
  gym      Gym?        @relation(fields: [gymId], references: [id], onDelete: SetNull)
  messages WaMessage[]

  @@index([gymId])
  @@index([status, lastMessageAt])
  @@map("wa_conversations")
}

model WaMessage {
  id          String      @id @default(uuid())
  direction   WaDirection
  body        String
  /// text | template | image | audio | document | …
  type        String      @default("text")
  waMessageId String?     @unique
  /// sent | delivered | read | failed (from Meta status webhooks)
  status      String?
  error       String?
  sentById    String?
  createdAt   DateTime    @default(now())

  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("wa_messages")
}
